@using WebMatrix.Data

@{
    ViewBag.Title = "Create Page";
}

@{
    var db = Database.Open("dvdRental");

    var genreSql = "SELECT genre_id, genre_name FROM genres ORDER BY genre_name";
    var genres = db.Query(genreSql);
    
    try
    {
        if (IsPost)
        {
            var sql = "INSERT INTO movies (title, release_year, classification, rental_price, description, poster_filename, runtime_minutes) " +
                      "VALUES (@0, CAST(@1 AS SMALLINT), @2, CAST(@3 AS NUMERIC(10,2)), @4, @5, CAST(@6 AS SMALLINT)) " +
                      "RETURNING movie_id";
            var newMovieID = db.QueryValue(sql, Request.Form["title"],
                Request.Form["release_year"], Request.Form["classification"],
                Request.Form["rental_price"], Request.Form["description"],
                Request.Form["poster_filename"], Request.Form["runtime_minutes"]);
            
            var movieGenresSql = "INSERT INTO movie_genres (movie_id, genre_id) VALUES (CAST(@0 AS INT), CAST(@1 AS INT))";

            foreach (var genre in Request.Form["movieGenres"].ToString().Split(','))
            {
                var movieGenreInsert = db.Execute(movieGenresSql, newMovieID, genre);
            }
            
            Response.Redirect("Details?id=" + newMovieID);
            return;
        }
    }
    catch (Exception e)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            <strong>Processing New Movie Creation!</strong>
            <p>@e.Message</p>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
}

<h1 class="text-center">Create New Rental Movie</h1>

<form method="post" action="/Movies/Create">
    <div class="card">
        <div class="card-header">
            <h2 class="text-center">Movie Information</h2>
        </div>

        <div class="card-body">
            <div class="row form-group mb-3">
                <label for="title" class="form-label">Movie Title</label>
                <input type="text" id="title" name="title" class="form-control"
                       placeholder="Movie title..." maxlength="200" required>
            </div>

            <div class="row form-group mb-3">
                <label class="form-label" for="release_year">Release Year</label>
                <input type="number" id="release_year" name="release_year" class="form-control"
                       min="1900" max="2040" step="1" placeholder="1999" required>
            </div>

            <div class="row form-group mb-3">
                <label for="classification" class="form-label">Select Classification</label>
                <select id="classification" name="classification" class="form-select" required>
                    <option value="" selected disabled>Select Classification</option>
                    <option value="G">G</option>
                    <option value="PG">PG</option>
                    <option value="M">M</option>
                    <option value="MA15+">MA15+</option>
                    <option value="R18+">R18+</option>
                </select>
            </div>
            
            <div class="row form-group mb-3">
                <label for="movieGenres" class="form-label">Movie Genres</label>
                <select id="movieGenres" name="movieGenres" class="form-select" multiple size="5">
                    @foreach (var genre in genres)
                    {
                        <option value="@genre.genre_id">@genre.genre_name</option>
                    }
                </select>
                <div class="form-text">
                    Hold Ctrl to select multiple genres
                </div>
            </div>

            <div class="row form-group mb-3">
                <label for="runtime_minutes" class="form-label">Runtime Minutes</label>
                <input type="number" id="runtime_minutes" name="runtime_minutes" class="form-control"
                       placeholder="Movie runtime in minutes..." step="1" min="1" max="1000" required>
            </div>

            <div class="row form-group mb-3">
                <label for="description" class="form-label">Movie Description</label>
                <textarea id="description" name="description" maxlength="5000" class="form-control"
                    placeholder="Movie description..." title="Movie Description" rows="5" required></textarea>
            </div>
            
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h2 class="text-center">Rental Information</h2>
        </div>

        <div class="card-body">
            <div class="row form-group mb-3">
                <label for="rental_price" class="form-label">Rental Price ($)</label>
                <input type="number" id="rental_price" class="form-control" name="rental_price"
                       step="0.05" min="1" max="100" placeholder="$0.00" required>
            </div>

            <div class="row form-group mb-3">
                <label for="poster_filename" class="form-label">Poster File Name</label>
                <input type="text" name="poster_filename" id="poster_filename" class="form-control"
                       placeholder="Movie poster file name... e.g. cold_storage.jpg"
                       title="Poster File Name" maxlength="250" required>
            </div>

            <div class="row form-group mb-3">
                <button type="submit" name="action" value="insert" class="btn btn-primary">Create Movie</button>
            </div>
        </div>
    </div>
</form>

<div class="d-flex justify-content-center mt-4">
    <a class="btn align-content-end btn-outline-primary" href="/Movies/Index">Return to Index</a>
</div>