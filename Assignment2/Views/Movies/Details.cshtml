@using WebMatrix.Data

@{
    ViewBag.Title = "Details Page";
}

@{
    var db = Database.Open("dvdRental");
    
    var queryMovieID = Request.QueryString["id"];
    dynamic movie = null;
    dynamic actors = null; // Can't set a var initial value to null
    dynamic genres = null;
    dynamic movieCopies = null;
    dynamic rentalInfo = null;
    var errorMessage = "";
    
    try
    {
        var sql = "SELECT * FROM movies WHERE movie_id = CAST(@0 AS INT)";

        movie = db.QuerySingle(sql, queryMovieID);

        if (movie != null)
        {
            var sqlMovieActors = "SELECT * " +
                                 "FROM actors a, movie_actors ma " +
                                 "WHERE ma.movie_ID = CAST(@0 AS INT) " +
                                 "AND a.actor_id = ma.actor_id";
            actors = db.Query(sqlMovieActors, queryMovieID);

            var sqlMovieGenres = "SELECT * " +
                                 "FROM genres g, movie_genres ma " +
                                 "WHERE ma.movie_ID = CAST(@0 AS INT) " +
                                 "AND g.genre_id = ma.genre_id";
            genres = db.Query(sqlMovieGenres, queryMovieID);

            var sqlMovieStores = "SELECT s.store_id, s.store_name, s.street_address, s.suburb, s.postcode, s.phone, " +
                                 "COUNT(DISTINCT c.copy_id) FILTER ( " +
                                 "WHERE c.retired = false " +
                                 ") AS total_copies, " +
                                 "COUNT(DISTINCT c.copy_id) FILTER ( " +
                                 "WHERE c.retired = true " +
                                 ") AS retired_copies, " +
                                 "COUNT(DISTINCT c.copy_ID) FILTER ( " +
                                 "WHERE c.retired = false " +
                                 "AND NOT EXISTS ( " +
                                 "SELECT 1 " +
                                 "FROM rental_items ri " +
                                 "WHERE ri.copy_id = c.copy_id " +
                                 "AND ri.return_date IS NULL ) " +
                                 ") AS available_copies " +
                                 "FROM copies c " +
                                 "JOIN stores s " +
                                 "ON c.store_id = s.store_id " +
                                 "WHERE c.movie_id = CAST(@0 AS INT) " +
                                 "GROUP BY s.store_id, s.store_name, s.street_address, s.suburb, s.postcode, s.phone " +
                                 "ORDER BY s.store_name";
            movieCopies = db.Query(sqlMovieStores, queryMovieID);
            
            var sqlRentalHistory = "SELECT cu.first_name, cu.last_name, ri.rental_id, c.copy_id, r.rental_date, ri.return_date, ri.due_date, ri.late_fee, s.store_name " +
                                   "FROM customers cu " +
                                   "JOIN rentals r " +
                                   "ON r.customer_id = cu.customer_id " +
                                   "JOIN rental_items ri " +
                                   "ON ri.rental_id = r.rental_id " +
                                   "JOIN copies c " +
                                   "ON c.copy_id = ri.copy_id " +
                                   "JOIN stores s " +
                                   "ON c.store_id = s.store_id " +
                                   "WHERE c.movie_id = CAST(@0 AS INT) " +
                                   "ORDER BY r.rental_date DESC, s.store_name";
            rentalInfo = db.Query(sqlRentalHistory, queryMovieID);
        }
    }
    catch (Exception)
    {
        errorMessage = "Invalid Movie ID";
        movie = null;
    }
}

@if (movie == null){
    <div class="alert alert-danger">
        @if (errorMessage == "")
        {
            <span>Movie not found</span>
        }
        else
        {
            @errorMessage
        }
    </div>
    <a href="/Movies/Index" class="btn btn-primary">
        Return to Movies Index
    </a>
} 
else 
{
    <div class="row g-4">
        <div class="col-md-4">
            <img src="/Images/@movie.poster_filename" class="img-fluid" alt="@movie.title">
        </div>
        
        <div class="col-md-8">
            <h1 class="text-center mb-2">@movie.title</h1>
            
            <p class="fs-5 fst-italic text-secondary text-center mb-2">Runtime: @movie.runtime_minutes mins &bull; Classification: @movie.classification &bull; Release Year:@movie.release_year</p>
            
            <div class="fst-italic text-secondary text-center mb-2">
                @{
                    int countGenre = 0;
                }
                
                @if (genres.Count > 0)
                {
                    foreach (var genre in genres)
                    {
                        if (countGenre > 0)
                        {
                            <span>&bull;</span>
                        }

                        <span>
                            @genre.genre_name
                        </span>

                        countGenre++;
                    }
                }
                else
                {
                    <span>
                        No genres assigned
                    </span>
                }
            </div>
            
            <div class="fst-italic text-secondary text-center mb-5">
                @{
                    int countActor = 0;
                }
                
                @if (actors.Count > 0)
                {
                    foreach (var actor in actors)
                    {
                        if (countActor > 0)
                        {
                            <span>&bull;</span>
                        }

                        <span>
                            @actor.first_name @actor.last_name (@actor.date_of_birth.ToString("dd/MM/yyyy"))
                        </span>

                        countActor++;
                    }
                }
                else
                {
                    <span>
                        No actors assigned
                    </span>
                }
            </div>
            
            <p class="mb-5">@movie.description</p>
            
            <div class="text-end">
                <p class="fs-5 fst-italic text-end">Rental price: @movie.rental_price.ToString("C")</p>
            </div>
        </div>
        
        <h2 class="fs-5 mb-2 text-center">Copy Locations</h2>
        
        <div class="row row-cols-2 g-2">
            @if (movieCopies.Count > 0)
            {
                foreach (var copy in movieCopies)
                {
                    <div class="col">
                        <div class="card h-100">
                            <div class="card-header">
                                <h3 class="fs-5 mb-1">@copy.store_name</h3>
                            </div>
                            <div class="card-body">
                                <p>@copy.street_address @copy.suburb @copy.postcode</p>
                                <p>@copy.phone</p>
                                <p>Store Copies: @copy.total_copies</p>
                                <p>Copies Available To Rent: @copy.available_copies</p>
                                <p>Retired Copies: @copy.retired_copies</p>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 alert alert-info">
                    No locations have this movie
                </div>
            }
        </div>
        
        <h2 class="fs-5 mb-2 text-center">Rental Information</h2>
        
        @if (rentalInfo.Count == 0)
        {
            <div class="alert alert-info">
                No rental history for this movie
            </div>
        }
        else
        {
            <div class="row row-cols-2 g-2">
                @foreach (var rental in rentalInfo)
                {
                    bool isOverdue = rental.return_date == null && rental.due_date < new DateTime(2026, 9, 28); // hard coded for testing, this will be changed for DateTime.Today
                    
                    <div class="col">
                        <div class="card h-100 @(isOverdue ? "bg-danger-subtle" : "")">
                            <div class="card-header">
                                <h3 class="fs-5 mb-1">@rental.first_name @rental.last_name</h3>
                            </div>
                            <div class="card-body">
                                <p>Rental ID: @rental.rental_id</p>
                                <p>Store: @rental.store_name</p>
                                <p>Copy ID: @rental.copy_id</p>
                                <p>Date Borrowed: @rental.rental_date.ToString("dd/MM/yyyy")</p>
                                <p>Due Date: @rental.due_date.ToString("dd/MM/yyyy")</p>
                                @if (rental.return_date == null)
                                {
                                    <p>Returned Date: Not returned</p>
                                }
                                else
                                {
                                    <p>Returned Date: @rental.return_date.ToString("dd/MM/yyyy")</p>
                                }
                                <p>Late Fee: @rental.late_fee.ToString("C")</p>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    
    <div class="d-flex justify-content-center mt-4">
        <a class="btn align-content-end btn-outline-primary" href="/Movies/Index">Return to Index</a>
    </div>
}
