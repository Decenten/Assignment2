@using WebMatrix.Data

@{
    ViewBag.Title = "Details Page";
}

@{
    var db = Database.Open("dvdRental");

    var sql = "SELECT * FROM movies WHERE movie_id = CAST(@0 AS INT)";
    var queryMovieID = Request.QueryString["id"];
    var movie = db.QuerySingle(sql, queryMovieID);
    
    
    var sqlMovieActors = "SELECT * " +
                         "FROM actors a, movie_actors ma " +
                         "WHERE ma.movie_ID = CAST(@0 AS INT) " +
                         "AND a.actor_id = ma.actor_id";
    var actors = db.Query(sqlMovieActors, queryMovieID);
    
    var sqlMovieGenres = "SELECT * " +
                         "FROM genres g, movie_genres ma " +
                         "WHERE ma.movie_ID = CAST(@0 AS INT) " +
                         "AND g.genre_id = ma.genre_id";
    var genres = db.Query(sqlMovieGenres, queryMovieID);

    var sqlMovieCopies = "SELECT * " +
                         "FROM copies c " +
                         "JOIN stores s " +
                         "ON c.store_id = s.store_id " +
                         "LEFT JOIN rental_items ri " +
                         "ON c.copy_id = ri.copy_id " +
                         "WHERE c.movie_ID = CAST(@0 AS INT)";
var movieCopies = db.Query(sqlMovieCopies, queryMovieID);
var copiesAval = 0;
foreach (var copy in movieCopies)
{
    if (copy.rental_id == null || (copy.rental_id != null && copy.return_date == null))
    {
        copiesAval++;
    }
    
}
}

@if (movie == null){
    <div class="alert alert-danger">
        Movie not found
    </div>
} else {
    <div class="row g-4">
        <div class="col-md-4">
            <img src="/Images/@movie.poster_filename" class="img-fluid" alt="@movie.title">
        </div>
        
        <div class="col-md-8">
            <h1 class="text-center mb-2">@movie.title</h1>
            
            <p class="fs-5 fst-italic text-secondary text-center mb-2">Runtime: @movie.runtime_minutes mins &bull; Classification: @movie.classification &bull; Release Year:@movie.release_year</p>
            
            <div class="fst-italic text-secondary text-center mb-2">
                @{
                    int countGenre = 0;
                }
                
                @foreach (var genre in genres)
                {
                    if (countGenre > 0)
                    {
                        <span>&bull;</span>
                    }
                    
                    <span>
                        @genre.genre_name
                    </span>

                    countGenre++;
                }
            </div>
            
            <div class="fst-italic text-secondary text-center mb-5">
                @{
                    int countActor = 0;
                }
                
                @foreach (var actor in actors)
                {
                    if (countActor > 0)
                    {
                        <span>&bull;</span>
                    }
                    
                    <span>
                        @actor.first_name @actor.last_name (@actor.date_of_birth.ToString("dd/MM/yyyy"))
                    </span>
                    
                    countActor++;
                }
            </div>
            
            <p class="mb-5">@movie.description</p>
            
            <div class="text-end">
                <p class="fs-5 fst-italic text-end">Rental price: @movie.rental_price.ToString("C")</p>
            </div>
            
            <div>
                <p class="mb-2 text-center">Copy Locations</p>
                <table class="table table-striped table-hover">
                    <thead>
                    <tr>
                        <th>Store</th>
                        <th>Store Address</th>
                        <th>Store Phone #</th>
                        <th>Copies</th>
                        <th>Copies Available</th>
                    </tr>
                    </thead>

                    <tbody>
                    @foreach (var copy in movieCopies)
                    {
                        <tr>
                            <td>@copy.store_name</td>
                            <td>@copy.street_address @copy.suburb @copy.postcode</td>
                            <td>@copy.phone</td>
                            <td>@movieCopies.Count()</td>
                            <td>@copiesAval</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            
            <a class="btn align-content-end btn-outline-primary" href="/Movies/Index">Return to Index</a>
        </div>
    </div>
}
