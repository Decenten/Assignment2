@using WebMatrix.Data

@{
    ViewBag.Title = "Index Page";
}

@{
    var db = Database.Open("dvdRental");

    var sqlSearchMovie = "SELECT * " +
                         "FROM movies m " +
                         "WHERE ( " +
                         "CAST(@0 AS TEXT) is null " +
                         "OR title ILIKE '%' || CAST(@0 AS TEXT) || '%' " +
                         ") " +
                         "AND ( " +
                         "CAST (@1 AS INTEGER) is null " +
                         "OR EXISTS ( " +
                         "SELECT * " +
                         "FROM movie_genres mg " +
                         "WHERE mg.movie_id = m.movie_id " +
                         "AND mg.genre_id = CAST (@1 AS INTEGER) )) ";
    
    var sqlGenres = "SELECT genre_id, genre_name " +
                    "FROM genres " +
                    "ORDER BY genre_name";
    
    var searchRequestText = Request.QueryString["searchTitle"];
    var genres = db.Query(sqlGenres);
    var searchRequestGenre = Request.QueryString["searchGenre"];
    
    var searchMovies = db.Query(sqlSearchMovie, searchRequestText, searchRequestGenre);
    


}

<h2 class="">Index</h2>

<form method="get" action="/Movies/Index">
    <input type="text" name="searchTitle" value="@searchRequestText" class="form-control"/>
    <select name="searchGenre" class="form-select">
        <option value="">All Genres</option>
        @foreach (var genre in genres)
        {
            <option value="@genre.genre_id" selected="@(searchRequestGenre == genre.genre_id.ToString())">
                @genre.genre_name
            </option>
        }
    </select>
    <button type="submit" class="btn btn-primary">Search</button>
</form>

<div class="row justify-content-center">
    @{
        foreach (var row in searchMovies)
        {
            <div class="card col-3 m-1">
                <img src="/Images/@row.poster_filename" class="card-img-top" alt="@row.title">
                <div class="card-body">
                    <h5 class="card-title text-center">@row.title</h5>
                    <p class="card-subtitle text-end">@row.release_year</p>
                    <p class="card-text text-end">@row.rental_price.ToString("C")</p>
                </div>
            </div>
        }
    }
</div>

    