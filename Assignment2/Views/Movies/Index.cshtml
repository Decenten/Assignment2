@using WebMatrix.Data

@{
    ViewBag.Title = "Index Page";
}

@{
    var db = Database.Open("dvdRental");

    /* Using NULLIF for the genre query due to issues with integers and checking if null
     This will return null if CAST(@1 AS TEXT) is null and works
     */
    var sqlSearchMovie = "SELECT * " +
                         "FROM movies m " +
                         "WHERE ( " +
                         "CAST(@0 AS TEXT) is null " +
                         "OR title ILIKE '%' || CAST(@0 AS TEXT) || '%' " +
                         ") " +
                         "AND ( " +
                         "NULLIF(CAST(@1 AS TEXT), '') is null " + 
                         "OR EXISTS ( " +
                         "SELECT * " +
                         "FROM movie_genres mg " +
                         "WHERE mg.movie_id = m.movie_id " +
                         "AND mg.genre_id = CAST (@1 AS INTEGER) )) " +
                         "ORDER BY " +
                         "CASE WHEN @2 = 'DESC' THEN title END DESC, " +
                         "CASE WHEN @2 IS NULL OR @2 = 'ASC' THEN title END ASC";
    
    var sqlGenres = "SELECT genre_id, genre_name " +
                    "FROM genres " +
                    "ORDER BY genre_name";
    
    
    var searchRequestText = Request.QueryString["searchTitle"];
    var genres = db.Query(sqlGenres);
    var searchRequestGenre = Request.QueryString["searchGenre"];
    var searchSort = Request.QueryString["searchSort"];
    
    var searchMovies = db.Query(sqlSearchMovie, searchRequestText, searchRequestGenre, searchSort);
    


}

<h1 class="text-center">Movie Index</h1>

<form method="get" action="/Movies/Index">
    <div class="row align-items-end">
        <div class="col-md-5">
            <input type="text" name="searchTitle" value="@searchRequestText" class="form-control" placeholder="Search for a movie"/>
        </div>
        
        <div class="col-md-5">
            <select name="searchGenre" class="form-select">
                <option value="">All Genres</option>
                @foreach (var genre in genres)
                {
                    <option value="@genre.genre_id" selected="@(searchRequestGenre == genre.genre_id.ToString())">
                        @genre.genre_name
                    </option>
                }
            </select>
        </div>
        
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Search</button>
        </div>
        
        <div class="col-md-1">
            @if (searchSort == "DESC")
            {
                <button type="submit" name="searchSort" value="ASC" class="btn btn-primary">Sort Title A-Z</button>
            }
            else
            {
                <button type="submit" name="searchSort" value="DESC" class="btn btn-primary">Sort Title Z-A</button>
            }
        </div>
        
    </div>
</form>

<div class="row justify-content-center">
    @{
        foreach (var row in searchMovies)
        {
            <div class="card col-3 m-1">
                <img src="/Images/@row.poster_filename" class="card-img-top" alt="@row.title">
                <div class="card-body">
                    <h5 class="card-title text-center">@row.title</h5>
                    <p class="card-subtitle text-end">@row.release_year</p>
                    <p class="card-text text-end">@row.rental_price.ToString("C")</p>
                </div>
            </div>
        }
    }
</div>

    